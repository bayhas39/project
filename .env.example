# DHRE Security Dashboard — sync API credentials
# Copy this file to `.env` and paste your own values.
#
# In the Upstash console: open your database -> "REST API" section.
# You need the REST URL and the REST token (not the read-only token).
#
# UPSTASH_REDIS_REST_URL="https://your-db-name.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-rest-token"

UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional: port for the sync API (the dashboard's static files use 8080).
PORT=8787
